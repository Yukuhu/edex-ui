{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/utils/**/*.js",
    "src/ipc/**/*.js",
    "src/types/**/*.d.ts",
    "src/_main_claude.js",
    "src/classes/clock.class.js",
    "src/classes/hardwareInspector.class.js",
    "src/classes/audiofx.class.js"
  ],
  "exclude": [
    "node_modules",
    "src/node_modules",
    "src/assets/vendor",
    "src/assets/css",
    "dist",
    "coverage",
    "prebuild-src"
  ]
}
